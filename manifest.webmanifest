{
  "id": "./",
  "name": "Mentha Nail Spa · CRM",
  "short_name": "Mentha CRM",
  "description": "Agenda, clientes e controle financeiro do Mentha Nail Spa",
  "lang": "pt-BR",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#F1F8F4",
  "theme_color": "#136E50",
  "categories": ["business", "productivity"],
  "icons": [
    { "src": "icons/icon-any-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-any-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Agenda", "url": "./?tab=agenda", "icons": [{ "src": "icons/icon-any-192.png", "sizes": "192x192" }] },
    { "name": "Novo atendimento", "url": "./?novo=1", "icons": [{ "src": "icons/icon-any-192.png", "sizes": "192x192" }] },
    { "name": "Clientes", "url": "./?tab=clientes", "icons": [{ "src": "icons/icon-any-192.png", "sizes": "192x192" }] }
  ]
}
